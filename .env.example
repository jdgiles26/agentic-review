# LLM (optional). Without a key, specialists run deterministic offline heuristics.
OPENAI_API_KEY=
REVIEW_MODEL=gpt-4o-mini
# Tried when the primary model errors or times out.
REVIEW_FALLBACK_MODEL=
REVIEW_LLM_TIMEOUT=60

# GitHub integration (PR review + webhooks)
GITHUB_TOKEN=

# Webhook HMAC secret (X-Hub-Signature-256). Webhooks are refused when unset,
# unless ALLOW_UNSIGNED_WEBHOOKS=true (local testing only).
GITHUB_WEBHOOK_SECRET=
ALLOW_UNSIGNED_WEBHOOKS=false

# Post review results back to the PR as a comment (outward-facing; off by default).
REVIEW_POST_COMMENTS=false

# CORS (comma-separated origins, * for all; credentials are disabled with *)
CORS_ORIGINS=http://localhost:3000

# Review history database
REVIEW_DB=.review/reviews.db
